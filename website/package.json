{
  "name": "spectacle-docs",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-live-codeblock": "^3.10.2",
    "@docusaurus/theme-search-algolia": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@tsconfig/docusaurus": "^1.0.7",
    "@types/node": "^18.19.130",
    "@types/react": "18.3.31",
    "clsx": "^1.2.1",
    "docusaurus-plugin-sass": "^0.2.7",
    "formidable-oss-badges": "^1.7.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "^18.3.1",
    "sass": "^1.104.1",
    "sass-loader": "^13.3.3",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build --out-dir build/open-source/spectacle",
    "build:vercel": "docusaurus build",
    "clear": "docusaurus clear",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "lint": "wireit",
    "lint:fix": "wireit",
    "prettier": "wireit",
    "prettier:fix": "wireit",
    "types:check": "wireit"
  },
  "wireit": {
    "lint": {
      "command": "nps lint:pkg -- -- \"*.js\" src",
      "files": [
        "../.eslintignore",
        "../.eslintrc",
        "*.js",
        "src/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "lint:fix": {
      "command": "pnpm run lint || nps lint:pkg:fix -- -- \"*.js\" src",
      "files": [
        "../.eslintignore",
        "../.eslintrc",
        "*.js",
        "src/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "prettier": {
      "command": "nps prettier:website -- -- \"*.js\" src",
      "files": [
        "../.prettierignore",
        "../.prettierrc",
        "*.js",
        "src/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "prettier:fix": {
      "command": "pnpm run prettier || nps prettier:website:fix -- -- \"*.js\" src",
      "files": [
        "../.prettierignore",
        "../.prettierrc",
        "*.js",
        "src/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "types:check": {
      "command": "nps types:check",
      "files": [
        "src/**/*.{ts,tsx}",
        "tsconfig.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}