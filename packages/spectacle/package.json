{
  "name": "spectacle",
  "version": "10.2.3",
  "description": "ReactJS Powered Presentation Framework",
  "types": "lib/index.d.ts",
  "main": "lib/index.js",
  "files": [
    "lib/"
  ],
  "module": "lib/index.mjs",
  "author": "Formidable Labs <hello@formidable.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FormidableLabs/spectacle.git"
  },
  "browserslist": "> 0.25%, not dead",
  "dependencies": {
    "broadcast-channel": "^4.20.2",
    "history": "^5.3.0",
    "kbar": "0.1.0-beta.48",
    "lodash.clonedeep": "^4.5.0",
    "mdast-builder": "^1.1.1",
    "mdast-zone": "^4.0.1",
    "merge-anything": "^3.0.7",
    "mousetrap": "^1.6.5",
    "query-string": "^7.1.3",
    "react-fast-compare": "^3.2.2",
    "react-is": "^18.3.1",
    "react-spring": "^9.7.5",
    "react-swipeable": "^7.0.2",
    "react-syntax-highlighter": "^15.6.6",
    "rehype-raw": "^5.1.0",
    "rehype-react": "^6.2.1",
    "remark-parse": "^8.0.3",
    "remark-rehype": "^7.0.0",
    "styled-components": "^5.3.11",
    "styled-system": "5.1.5",
    "unified": "^9.2.2",
    "unist-util-visit": "^2.0.3",
    "use-resize-observer": "^9.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/mousetrap": "^1.6.15",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-is": "^17.0.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/styled-components": "^5.1.36",
    "@types/styled-system": "^5.1.25",
    "@types/unist": "^2.0.11",
    "csstype": "^3.2.3",
    "esbuild-plugin-external-global": "^1.0.1",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^6.7.0"
  },
  "scripts": {
    "build": "wireit",
    "build:lib": "wireit",
    "build:lib:watch": "wireit",
    "lint": "wireit",
    "lint:fix": "wireit",
    "prettier": "wireit",
    "prettier:fix": "wireit",
    "types:check": "wireit",
    "test": "wireit"
  },
  "publishConfig": {
    "provenance": true
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:lib"
      ]
    },
    "build:lib": {
      "command": "nps tsup",
      "files": [
        "./tsup.config.ts",
        "src/**",
        "!src/**/*.test.*",
        "../../package-scripts.js",
        "../../.babelrc.js",
        "../../.babelrc.build.js"
      ],
      "output": [
        "lib/**/*.js"
      ],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "build:lib:watch": {
      "command": "nps tsup:watch",
      "files": [
        "src/**",
        "!src/**/*.test.*",
        "../../package-scripts.js",
        "../../.babelrc.js",
        "../../.babelrc.build.js"
      ],
      "output": [
        "lib/**/*.js"
      ],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "lint": {
      "command": "nps lint:pkg -- -- \"*.js\" src",
      "files": [
        "../../.eslintignore",
        "../../.eslintrc",
        "*.js",
        "src/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "lint:fix": {
      "command": "pnpm run lint || nps lint:pkg:fix -- -- \"*.js\" src",
      "files": [
        "../../.eslintignore",
        "../../.eslintrc",
        "*.js",
        "src/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "prettier": {
      "command": "nps prettier:pkg -- -- \"*.js\" src",
      "files": [
        "../../.prettierignore",
        "../../.prettierrc",
        "*.js",
        "src/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "prettier:fix": {
      "command": "pnpm run prettier || nps prettier:pkg:fix -- -- \"*.js\" src",
      "files": [
        "../../.prettierignore",
        "../../.prettierrc",
        "*.js",
        "src/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "types:check": {
      "command": "nps types:check",
      "files": [
        "src/**/*.{ts,tsx}",
        "../../tsconfig.json",
        "tsconfig.json"
      ],
      "dependencies": [],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "test": {
      "command": "nps jest",
      "files": [
        "src/**",
        "../../.babelrc.js"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    }
  }
}
